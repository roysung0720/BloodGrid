MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_ROUTING_PROFILE=mapbox/driving
ROUTING_TIMEOUT_SECONDS=12
OPENAI_API_KEY=
BACKEND_BASE_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8000
BLOODGRID_SCENARIO=rural_ga_initial_v1
# Optional local override. Defaults to the selected scenario's target coverage time.
BLOODGRID_COVERAGE_TARGET_MINUTES=
# Optional meeting-spot rule settings. Blank values use the defaults shown.
# BLOODGRID_MEETING_DIRECTION_TOLERANCE_MINUTES=3
# BLOODGRID_MEETING_MAX_DELAY_FRACTION=0.25
# BLOODGRID_MEETING_MIN_DELAY_CAP_MINUTES=5
# BLOODGRID_MEETING_MIN_BLOOD_GAIN_MINUTES=3
# BLOODGRID_MEETING_CORRIDOR_METERS=1200
# BLOODGRID_MEETING_MAX_CANDIDATES=40
# Optional Ambulance UI settings. Blank values use the defaults shown.
# BLOODGRID_AMBULANCE_SIM_SPEED_MULTIPLIER=5
# BLOODGRID_AMBULANCE_ARRIVAL_RADIUS_METERS=150
# BLOODGRID_AMBULANCE_POSITION_REPORT_SECONDS=5
# BLOODGRID_AMBULANCE_ETA_REFRESH_SECONDS=60
# BLOODGRID_REQUEST_POLL_SECONDS=3
